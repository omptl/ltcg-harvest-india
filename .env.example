# Copy this file to `.env` (which is gitignored) and fill in real values
# before running scripts/e2e_web_test.py. NEVER commit a populated .env.

# Required
LTCGH_CAS_PATH=C:/path/to/your_cas.pdf
LTCGH_CAS_PASSWORD=your_pdf_password

# Optional — broker tax P&L (CSV in canonical schema, or Zerodha Console xlsx)
LTCGH_STOCKS_LEDGER=C:/path/to/your_tax_pnl.xlsx

# Optional overrides
# LTCGH_WEB_URL=http://localhost:8000/index.html
# LTCGH_SHOT_PATH=C:/tmp/web_e2e.png
